+++ b/src/shared/ojak-terminal-selection.ts
@@ -0,0 +1,18 @@
+import type { SessionOptionValue } from './native-chat-session-options'
+import type { OjakTerminalSelection } from './ojak-launch-recovery'
+
+export const OJAK_TERMINAL_SELECTION_ENV = 'ORCA_OJAK_TERMINAL_SELECTION'
+
+/** Transient startup metadata; main removes it before handing the environment to a child. */
+export function ojakTerminalSelectionEnv(
+  agent: string,
+  text: string,
+  delivery: 'submit' | 'draft',
+  sessionOptions?: Record<string, SessionOptionValue>
+): Record<string, string> {
+  if (agent !== 'omp') return {}
+  const selection: OjakTerminalSelection = {
+    version: 1, prompt: { text, delivery }, ...(sessionOptions ? { sessionOptions } : {})
+  }
+  return { [OJAK_TERMINAL_SELECTION_ENV]: JSON.stringify(selection) }
+}
