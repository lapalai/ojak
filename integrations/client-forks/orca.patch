+
+const recoveries = new WeakMap<OrcaRuntimeService, { queue: OjakLaunchQueue; recovery: OjakLaunchRecovery }>()
+
+async function localWorkspace(runtime: OrcaRuntimeService, id: string): Promise<void> {
+  if (!await runtime.resolveStructuredAgentSessionLocalWorkspacePath(`id:${id}`)) {
+    throw new Error('Select a native local workspace for this saved Ojak launch.')
+  }
+}
+
+function terminalOwnerPresent(store: RuntimeStore, notice: OjakLaunchNotice): boolean {
+  const { paneKey, tabId, worktreeId } = notice.owner
+  if (!paneKey || !tabId) return false
+  return (store.getWorkspaceSessionHostIds?.() ?? ['local']).some((hostId) => {
+    const session = store.getWorkspaceSession?.(hostId)
+    return !!session && paneBelongsToTerminalLayout({ paneKey, tabId }, session,
+      new Set((session.tabsByWorktree[worktreeId] ?? []).map((tab) => tab.id)))
+  })
+}
+
+/** Cold starts persist their workspace tab before the provider's visible-session index exists. */
+function structuredOwnerTab(store: RuntimeStore, notice: OjakLaunchNotice) {
+  for (const hostId of store.getWorkspaceSessionHostIds?.() ?? ['local']) {
+    const tab = store.getWorkspaceSession?.(hostId)?.unifiedTabs?.[notice.owner.worktreeId]?.find((entry) =>
+      entry.contentType === 'agent-session' && entry.entityId === notice.owner.sessionId &&
+      (!entry.executionHostId || entry.executionHostId === 'local'))
+    if (tab) return tab
+  }
+  return undefined
+}
+
+async function launchTerminal(runtime: OrcaRuntimeService, queue: OjakLaunchQueue,
+  notice: OjakLaunchNotice, target?: string): Promise<void> {
+  if (notice.recovery?.kind !== 'terminal') throw new Error('Missing terminal selection.')
+  const { selection, cwd, shellOverride } = notice.recovery
+  if (target) {
+    const pane = allocateTerminalPaneIdentity({})
+    const next = { ...notice, key: `terminal:${target}:${pane.paneKey}`,
+      recovery: { kind: 'terminal' as const, selection },
+      owner: { kind: 'terminal' as const, worktreeId: target, tabId: pane.tabId, paneKey: pane.paneKey } }
+    queue.retarget(notice.key, next)
+    notice = next
+  }
+  let carried = false
+  const prompt = selection.prompt
+  await ojakLaunchPrompt.run(prompt, () => ojakRecoveryDispatch.run(true, async () => {
+    const terminal = await runtime.createTerminal(`id:${notice.owner.worktreeId}`, {
+      startupAgent: 'omp', ...paneIdentity(notice.owner.paneKey), requireFreshPane: true,
+      surfaceOwner: false, presentation: 'background',
+      ...(target ? {} : { cwd, shellOverride }),
+      launchPreferences: toAgentLaunchPreferences(selection.sessionOptions),
+      onStartupPromptCarry: (value: boolean) => { carried = value },
+      ...(prompt.delivery === 'draft' ? { startupDraft: prompt.text } : {
+        startupPrompt: prompt.text
+      })
+    })
+    if (prompt.text.trim() && !carried &&
+      !await deliverTerminalAgentLaunchPrompt({ runtime, handle: terminal.handle, agent: 'omp',
+        freshLaunch: true, text: prompt.text, delivery: prompt.delivery })) {
+      throw new Error('The agent started but prompt delivery is unconfirmed. Inspect its pane; the saved input will not be replayed.')
+    }
+    queue.remove(notice.key)
+  })).catch((error: unknown) => {
+    const row = queue.notices().find((entry) => entry.key === notice.key)
+    if (row) queue.save({ ...row, message: error instanceof Error ? error.message : String(error) })
+    throw error
+  })
+}
+
+async function launchStructured(runtime: OrcaRuntimeService, store: RuntimeStore, queue: OjakLaunchQueue,
+  notice: OjakLaunchNotice, target?: string): Promise<void> {
+  const recovery = notice.recovery
+  if (recovery?.kind !== 'structured') throw new Error('Missing structured selection.')
+  if (target && target !== notice.owner.worktreeId) {
+    throw new Error('Select the saved chat’s original workspace to resume its journal; moving a conversation requires a new launch.')
+  }
+  await runtime.ensureStructuredAgentSessionHost()
+  const host = getStructuredAgentSessionHost()
+  if (!host) throw new Error('Structured session host is unavailable.')
+  let record = host.deps.store.getRecord(recovery.sessionId)
+  if (!record || (record.provider !== 'omp' && record.provider !== 'pi') ||
+    record.location.executionHostId !== 'local' || record.location.wslDistro) {
+    throw new Error('Saved structured session is no longer a native local omp session.')
+  }
+  if (!(await runtime.getStructuredAgentSessionCreateSupport(`id:${notice.owner.worktreeId}`, record.provider)).supported) {
+    throw new Error('This structured agent is no longer enabled for the saved workspace.')
+  }
+  const tab = structuredOwnerTab(store, notice)
+  if (!target && !tab) {
+    throw new Error('The saved chat was closed; it will not be reopened automatically.')
+  }
+  const coldStart = record.providerHandleChain.length === 0
+  if (coldStart) {
+    // No provider conversation was created. Reuse its reserved record and tab, not a new create.
+    const attached = await host.attach({ callerKey: 'ojak-unsent-recovery' }, {
+      ...attachParamsForRecord(record, {
+        clientOperationId: createStructuredAgentSessionOperationId(randomUUID),
+        expectedRuntimeFence: record.lease.runtimeFence
+      }),
+      ...(tab ? { surfaceTabId: tab.id } : {})
+    })
+    if (!attached.ok) throw new Error(attached.refusal.message)
+    record = host.deps.store.getRecord(recovery.sessionId)
+    if (!record) throw new Error('Saved structured session disappeared during recovery.')
+  }
+  if (target || coldStart) await runtime.publishStructuredAgentSessionTab({ workspaceId: record.location.workspaceId,
+    sessionId: record.sessionId, agent: record.provider, activate: false })
+  // Opening folds never-handed submissions into the existing durable queue; Resume adds no message.
+  await host.journalSnapshot(recovery.sessionId)
+  if (queue.isSuspended() || (!coldStart && queue.notices().find((row) => row.key === notice.key)?.phase !== 'queued')) return
+  const result = await host.queuedMessagesResume({ callerKey: 'ojak-unsent-recovery' }, {
+    envelope: { sessionId: record.sessionId,
+      clientOperationId: createStructuredAgentSessionOperationId(randomUUID),
+      expectedRuntimeFence: record.lease.runtimeFence,
+      payloadFingerprint: structuredAgentSessionPayloadFingerprint({ method: 'agentSession.queuedMessagesResume',
+        sessionId: record.sessionId, fields: {} }) }
+  })
+  if (!result.ok) throw new Error(result.refusal.message)
+}
+
+async function recoveryFor(runtime: OrcaRuntimeService, store: RuntimeStore): Promise<OjakLaunchRecovery> {
+  const queue = await ojakLaunchQueue()
+  const existing = recoveries.get(runtime)
+  if (existing?.queue === queue) return existing.recovery
+  const recovery = new OjakLaunchRecovery(queue, {
+      ownerPresent: async (notice) => {
+        await localWorkspace(runtime, notice.owner.worktreeId)
+        if (notice.owner.kind === 'terminal') return terminalOwnerPresent(store, notice)
+        return structuredOwnerTab(store, notice) !== undefined
+      },
+      launch: async (notice, target) => {
+        await localWorkspace(runtime, target ?? notice.owner.worktreeId)
+        if (queue.isSuspended() || queue.notices().find((row) => row.key === notice.key)?.phase !== 'queued') return
+        if (notice.recovery?.kind === 'terminal') {
+          const originalPresent = terminalOwnerPresent(store, notice)
+          if (!target && !originalPresent) throw new Error('The saved pane was closed; it will not be recreated automatically.')
+          if (target && originalPresent && target !== notice.owner.worktreeId) {
+            throw new Error('The original pane still exists. Select its workspace to resume there.')
+          }
+          await launchTerminal(runtime, queue, notice, originalPresent ? undefined : target)
+        } else await launchStructured(runtime, store, queue, notice, target)
+      }
+  })
+  recoveries.set(runtime, { queue, recovery })
+  return recovery
+}
+
+export function restoreOjakLaunches(runtime: OrcaRuntimeService, store: RuntimeStore): void {
+  void recoveryFor(runtime, store).then((recovery) => recovery.restore()).catch(reportRecoveryError)
+}
+
+export async function resumeOjakLaunch(runtime: OrcaRuntimeService, store: RuntimeStore,
+  key: string, target: string): Promise<void> {
+  await localWorkspace(runtime, target)
+  const recovery = await recoveryFor(runtime, store)
+  void recovery.resume(key, target).catch(async (error: unknown) => {
+    const queue = await ojakLaunchQueue()
+    const row = queue.notices().find((notice) => notice.key === key)
+    if (row) queue.save({ ...row, message: error instanceof Error ? error.message : String(error) })
+    reportRecoveryError(error)
+  }).catch(reportRecoveryError)
+}
+
+function reportRecoveryError(error: unknown): void {
+  createStructuredAgentSessionLogger().warn('Ojak saved launch recovery failed', { scope: 'ojak-launch-recovery', error })
+}
