+++ b/src/main/agent-launch/ojak-launch-recovery.ts
@@ -0,0 +1,41 @@
+import type { OjakLaunchNotice } from '../../shared/ojak-launch-admission'
+import type { OjakLaunchQueue } from './ojak-launch-queue'
+
+/** Reconstructs only proven-unsent work. Process ownership stays with each existing launch path. */
+export class OjakLaunchRecovery {
+  private readonly running = new Set<string>()
+
+  constructor(private readonly queue: OjakLaunchQueue, private readonly deps: {
+    ownerPresent(notice: OjakLaunchNotice): Promise<boolean>
+    launch(notice: OjakLaunchNotice, targetWorktreeId?: string): Promise<void>
+  }) {}
+
+  async restore(): Promise<void> {
+    await Promise.all(this.queue.notices().filter((row) => row.phase === 'queued').map(async (row) => {
+      try { await this.resume(row.key) } catch (error) {
+        const current = this.queue.notices().find((entry) => entry.key === row.key)
+        if (current?.phase === 'queued' && !this.queue.isWaiting(row.key)) {
+          this.queue.save({ ...current, message: error instanceof Error ? error.message : String(error) })
+        }
+      }
+    }))
+  }
+
+  async resume(key: string, targetWorktreeId?: string): Promise<void> {
+    if (this.running.has(key) || this.queue.isWaiting(key)) return
+    if (this.queue.isSuspended()) return
+    const notice = this.queue.notices().find((row) => row.key === key)
+    if (!notice || notice.phase !== 'queued') throw new Error('Only a saved unsent launch can resume.')
+    if (!notice.recovery) throw new Error('This older launch has no safe recovery selection. Copy its saved input into a new launch.')
+    this.running.add(key)
+    try {
+      if (!targetWorktreeId && !await this.deps.ownerPresent(notice)) {
+        throw new Error('The original pane is closed or unavailable. Select a local workspace and Resume, or cancel this saved launch.')
+      }
+      if (this.queue.isSuspended() || this.queue.notices().find((row) => row.key === key)?.phase !== 'queued') return
+      await this.deps.launch(notice, targetWorktreeId)
+    } finally {
+      this.running.delete(key)
+    }
+  }
+}
