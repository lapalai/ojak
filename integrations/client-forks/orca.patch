@@ -0,0 +1,164 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import type { OjakLaunchNotice } from '../../shared/ojak-launch-admission'
+import { OjakLaunchQueue, type OjakLaunchTicket } from './ojak-launch-queue'
+import type { OjakAdmissionSample } from './ojak-managed-launch'
+import { OJAK_LAUNCH_LIMIT } from './ojak-launch-journal'
+
+const managed = { tokenPath: '/unused/bridge.token' }
+const ready = { ready: true, reason: 'ready', pollAfterMs: 500 }
+const pressure = { ready: false, reason: 'resource_pressure', pollAfterMs: 500 }
+function notice(key: string): OjakLaunchNotice {
+  return { key, owner: { kind: 'terminal', worktreeId: 'folder-1', tabId: key },
+    phase: 'queued', message: 'Waiting', savedCommand: 'omp', savedPrompt: `input-${key}` }
+}
+function journal() {
+  const rows = new Map<string, OjakLaunchNotice>()
+  return { rows, list: () => [...rows.values()],
+    save: (value: OjakLaunchNotice) => { rows.set(value.key, value) },
+    remove: (key: string) => { rows.delete(key) } }
+}
+const queues: OjakLaunchQueue[] = []
+const tickets: OjakLaunchTicket[] = []
+beforeEach(() => vi.useFakeTimers())
+afterEach(async () => {
+  for (const queue of queues.splice(0)) queue.cancelAll()
+  for (const ticket of tickets.splice(0)) ticket.release()
+  await vi.runAllTimersAsync()
+  vi.useRealTimers()
+})
+function queue(store = journal(), sample = vi.fn(async (): Promise<OjakAdmissionSample> => ready)) {
+  const result = new OjakLaunchQueue(store, sample)
+  queues.push(result)
+  return { queue: result, store, sample }
+}
+async function admitted(promise: Promise<OjakLaunchTicket>): Promise<OjakLaunchTicket> {
+  await vi.advanceTimersByTimeAsync(0)
+  const ticket = await promise
+  tickets.push(ticket)
+  return ticket
+}
+
+describe('Ojak pre-process admission', () => {
+  it('persists input before polling and starts only after pressure clears', async () => {
+    const h = queue()
+    h.sample.mockResolvedValue(pressure)
+    const granted = vi.fn()
+    const pending = h.queue.acquire(notice('a'), managed).then((ticket) => { granted(); return ticket })
+    expect(h.store.rows.get('a')).toMatchObject({ phase: 'queued', savedPrompt: 'input-a' })
+    await vi.advanceTimersByTimeAsync(2_000)
+    expect(granted).not.toHaveBeenCalled()
+    h.sample.mockResolvedValue(ready)
+    await vi.advanceTimersByTimeAsync(500)
+    const ticket = await admitted(pending)
+    ticket.submitted()
+    expect(h.store.rows.get('a')?.phase).toBe('submitted')
+    ticket.committed()
+    expect(h.store.rows.has('a')).toBe(false)
+    ticket.release()
+  })
+
+  it('serializes terminal and structured starts and samples again after the spacing window', async () => {
+    const h = queue()
+    const first = await admitted(h.queue.acquire(notice('a'), managed))
+    const next = h.queue.acquire({ ...notice('b'), owner: { kind: 'structured', worktreeId: 'folder-1', sessionId: 'b' } }, managed)
+    await vi.advanceTimersByTimeAsync(5_000)
+    expect(h.sample).toHaveBeenCalledTimes(1)
+    first.submitted()
+    first.committed()
+    first.release()
+    await vi.advanceTimersByTimeAsync(1_999)
+    expect(h.sample).toHaveBeenCalledTimes(1)
+    await vi.advanceTimersByTimeAsync(1)
+    const second = await admitted(next)
+    expect(h.sample).toHaveBeenCalledTimes(2)
+    second.submitted()
+    second.committed()
+    second.release()
+  })
+
+  it('cancels both the active poll and an unsampled tail without discarding their inputs', async () => {
+    const h = queue()
+    h.sample.mockResolvedValue(pressure)
+    const first = h.queue.acquire(notice('a'), managed).catch((error: unknown) => error)
+    const second = h.queue.acquire(notice('b'), managed).catch((error: unknown) => error)
+    await vi.advanceTimersByTimeAsync(0)
+    expect(h.queue.cancel('b')).toBe(true)
+    expect(h.queue.cancel('a')).toBe(true)
+    await vi.advanceTimersByTimeAsync(0)
+    expect(await first).toBeInstanceOf(Error)
+    expect(await second).toBeInstanceOf(Error)
+    expect(h.store.list()).toEqual(expect.arrayContaining([
+      expect.objectContaining({ key: 'a', phase: 'cancelled', savedPrompt: 'input-a' }),
+      expect.objectContaining({ key: 'b', phase: 'cancelled', savedPrompt: 'input-b' })
+    ]))
+    expect(h.sample).toHaveBeenCalledTimes(1)
+    expect(h.queue.dismiss('a')).toBe(true)
+  })
+
+  it('honors an acquisition abort without granting a late ready sample', async () => {
+    const response = Promise.withResolvers<OjakAdmissionSample>()
+    const h = queue(journal(), vi.fn(() => response.promise))
+    const stop = new AbortController()
+    const pending = h.queue.acquire(notice('a'), managed, stop.signal).catch((error: unknown) => error)
+    await vi.advanceTimersByTimeAsync(0)
+    stop.abort(new Error('lease closed'))
+    response.resolve(ready)
+    await vi.advanceTimersByTimeAsync(0)
+    expect(await pending).toMatchObject({ message: 'lease closed' })
+    expect(h.store.rows.get('a')?.phase).toBe('cancelled')
+  })
+
+  it('reacquires only identical unsent intent after recovery and never a submitted launch', async () => {
+    const store = journal()
+    store.save(notice('a'))
+    const h = queue(store)
+    expect(() => h.queue.acquire({ ...notice('a'), savedPrompt: 'replacement' }, managed)).toThrow(/reconciliation/)
+    const ticket = await admitted(h.queue.acquire(notice('a'), managed))
+    ticket.submitted()
+    ticket.release(new Error('reply lost'))
+    const restarted = queue(store)
+    expect(() => restarted.queue.acquire(notice('a'), managed)).toThrow(/reconciliation/)
+    expect(restarted.queue.cancel('a')).toBe(false)
+    expect(restarted.queue.dismiss('a')).toBe(false)
+    expect(store.rows.get('a')).toMatchObject({ phase: 'submitted', savedPrompt: 'input-a' })
+  })
+
+  it('keeps recovered prompt uncertainty after the process ownership commit', async () => {
+    const h = queue()
+    const ticket = await admitted(h.queue.acquire({ ...notice('a'), deliveryPending: true }, managed))
+    ticket.submitted()
+    ticket.committed(true)
+    ticket.release()
+    expect(h.store.rows.get('a')).toMatchObject({
+      phase: 'submitted', deliveryPending: true, savedPrompt: 'input-a'
+    })
+    expect(() => h.queue.acquire(notice('a'), managed)).toThrow(/reconciliation/)
+    expect(h.queue.cancel('a')).toBe(false)
+    expect(h.queue.dismiss('a')).toBe(false)
+  })
+
+  it('refuses a full queue before replacing any accepted input', async () => {
+    const h = queue()
+    h.sample.mockResolvedValue(pressure)
+    const waiting = Array.from({ length: OJAK_LAUNCH_LIMIT }, (_, index) =>
+      h.queue.acquire(notice(String(index)), managed).catch((error: unknown) => error))
+    expect(() => h.queue.acquire(notice('overflow'), managed)).toThrow(/full/)
+    expect(h.store.rows.has('overflow')).toBe(false)
+    h.queue.cancelAll()
+    await vi.advanceTimersByTimeAsync(0)
+    await Promise.all(waiting)
+  })
+
+  it('fails closed when persistence or authenticated admission fails', async () => {
+    const h = queue()
+    const save = vi.spyOn(h.store, 'save').mockImplementationOnce(() => { throw new Error('disk full') })
+    expect(() => h.queue.acquire(notice('a'), managed)).toThrow('disk full')
+    expect(h.sample).not.toHaveBeenCalled()
+    save.mockRestore()
+    h.sample.mockRejectedValue(new Error('Ojak admission refused (401)'))
+    const pending = h.queue.acquire(notice('b'), managed).catch((error: unknown) => error)
+    await vi.advanceTimersByTimeAsync(0)
+    expect(await pending).toMatchObject({ message: 'Ojak admission refused (401)' })
+    expect(h.store.rows.get('b')).toMatchObject({ phase: 'failed', savedPrompt: 'input-b' })
+  })
+})
diff --git a/src/main/agent-launch/ojak-launch-queue.ts b/src/main/agent-launch/ojak-launch-queue.ts
new file mode 100644
index 00000000..d2e4ac83
--- /dev/null
+++ b/src/main/agent-launch/ojak-launch-queue.ts
@@ -0,0 +1,214 @@
+import type { OjakLaunchNotice } from '../../shared/ojak-launch-admission'
+import { OJAK_LAUNCH_LIMIT } from './ojak-launch-journal'
+import { readOjakAdmission, type OjakManagedLaunch } from './ojak-managed-launch'
+
+export type OjakLaunchTicket = {
+  /** Durable before physical dispatch. A crash from here is never automatically retried. */
+  submitted(): void
+  /** Only after the existing ownership record/binding has committed. */
+  committed(retainInput?: boolean): void
+  release(error?: unknown): void
+  signal: AbortSignal
+}
+
+type Entry = {
+  notice: OjakLaunchNotice
+  managed: OjakManagedLaunch
+  stop: AbortController
+  signal: AbortSignal
+  resolve: (ticket: OjakLaunchTicket) => void
+  reject: (error: unknown) => void
+  cleanup: () => void
+  cancelled: boolean
+}
+
+export function waitOjakPoll(ms: number, signal: AbortSignal): Promise<void> {
+  signal.throwIfAborted()
+  return new Promise((resolve, reject) => {
+    const abort = (): void => {
+      clearTimeout(timer)
+      signal.removeEventListener('abort', abort)
+      reject(signal.reason)
+    }
+    const timer = setTimeout(() => {
+      signal.removeEventListener('abort', abort)
+      resolve()
+    }, ms)
+    timer.unref?.()
+    signal.addEventListener('abort', abort, { once: true })
+  })
+}
+
+/** One local startup at a time, shared by TUI and structured lanes. Ready is not a reservation. */
+export class OjakLaunchQueue {
+  private readonly pending: Entry[] = []
+  private active: Entry | null = null
+  private readonly entries = new Map<string, Entry>()
+  private nextStartAt = 0
+  private stopped = false
+
+  constructor(private readonly journal: {
+    list(): OjakLaunchNotice[]
+    save(notice: OjakLaunchNotice, replacesKey?: string): void
+    remove(key: string): void
+  }, private readonly sample = readOjakAdmission) {}
+
+  notices(): OjakLaunchNotice[] {
+    return this.journal.list().map((notice) => ({
+      ...notice,
+      waiting: this.entries.has(notice.key)
+    }))
+  }
+
+  isWaiting(key: string): boolean { return this.entries.has(key) }
+
+  isSuspended(): boolean { return this.stopped }
+
+  save(notice: OjakLaunchNotice): void { this.journal.save(notice) }
+
+  remove(key: string): void { this.journal.remove(key) }
+
+  retarget(key: string, notice: OjakLaunchNotice): void {
+    if (this.entries.has(key)) throw new Error('This launch is already waiting.')
+    this.journal.save(notice, key)
+  }
+
+  /** Quit/reconnect releases the waiter, not the user's accepted work. */
+  suspend(): void {
+    this.stopped = true
+    for (const entry of this.entries.values()) {
+      if (entry.notice.phase === 'queued') {
+        entry.stop.abort(new Error('Orca paused this unsent launch; it will resume after restart.'))
+      }
+    }
+  }
+
+  cancel(key: string): boolean {
+    const entry = this.entries.get(key)
+    if (entry && entry.notice.phase === 'queued') {
+      this.journal.save({ ...entry.notice, phase: 'cancelled', message: 'Ojak launch cancelled; saved input was not sent.' })
+      entry.cancelled = true
+      entry.stop.abort(new Error('Ojak launch cancelled; saved input was not sent.'))
+      return true
+    }
+    const notice = this.journal.list().find((row) => row.key === key)
+    if (!entry && notice?.phase === 'queued') {
+      this.journal.save({ ...notice, phase: 'cancelled', message: 'Ojak launch cancelled; saved input was not sent.' })
+      return true
+    }
+    return false
+  }
+
+  dismiss(key: string): boolean {
+    const notice = this.journal.list().find((row) => row.key === key)
+    if (!this.entries.has(key) && (notice?.phase === 'cancelled' || notice?.phase === 'failed')) {
+      this.journal.remove(key)
+      return true
+    }
+    return false
+  }
+
+  cancelAll(): void {
+    for (const entry of this.entries.values()) {
+      if (entry.notice.phase === 'queued') this.cancel(entry.notice.key)
+    }
+  }
+
+  acquire(notice: OjakLaunchNotice, managed: OjakManagedLaunch, signal?: AbortSignal): Promise<OjakLaunchTicket> {
+    signal?.throwIfAborted()
+    if (this.stopped) throw new Error('Ojak launch recovery is stopping.')
+    if (this.entries.has(notice.key)) throw new Error('This Ojak launch is already waiting.')
+    const saved = this.journal.list().find((row) => row.key === notice.key)
+    if (saved && (saved.phase !== 'queued' ||
+      (!saved.recovery && saved.savedCommand !== notice.savedCommand) ||
+      (notice.savedPrompt !== undefined && saved.savedPrompt !== notice.savedPrompt))) {
+      throw new Error('This Ojak launch needs reconciliation. Its saved input will not be launched again automatically.')
+    }
+    if (saved) notice = { ...saved, ...notice, savedPrompt: saved.savedPrompt,
+      recovery: notice.recovery?.kind === 'structured' ? notice.recovery : saved.recovery ?? notice.recovery }
+    if (this.entries.size >= OJAK_LAUNCH_LIMIT) throw new Error('Ojak launch queue is full. Cancel a waiting launch and keep your draft.')
+    this.journal.save(notice)
+    const stop = new AbortController()
+    const combined = signal ? AbortSignal.any([signal, stop.signal]) : stop.signal
+    return new Promise((resolve, reject) => {
+      const entry: Entry = { notice, managed, stop, signal: combined, resolve, reject, cleanup: () => {}, cancelled: false }
+      const abort = (): void => {
+        if (this.active === entry) return
+        const index = this.pending.indexOf(entry)
+        if (index >= 0) this.pending.splice(index, 1)
+        this.finish(entry, combined.reason)
+      }
+      entry.cleanup = () => combined.removeEventListener('abort', abort)
+      combined.addEventListener('abort', abort, { once: true })
+      this.entries.set(notice.key, entry)
+      this.pending.push(entry)
+      if (combined.aborted) abort()
+      this.pump()
+    })
+  }
+
+  private pump(): void {
+    if (this.active || this.stopped) return
+    const entry = this.pending.shift()
+    if (!entry) return
+    this.active = entry
+    void this.wait(entry).catch((error: unknown) => this.finish(entry, error))
+  }
+
+  private async wait(entry: Entry): Promise<void> {
+    await waitOjakPoll(Math.max(0, this.nextStartAt - Date.now()), entry.signal)
+    for (;;) {
+      entry.signal.throwIfAborted()
+      const sample = await this.sample(entry.managed, entry.signal)
+      entry.signal.throwIfAborted()
+      if (sample.ready) break
+      const message = sample.reason === 'service_unavailable'
+        ? 'Waiting for Ojak service. Input is saved; no agent has started.'
+        : `Waiting for Ojak capacity (${sample.reason}). Input is saved; no agent has started.`
+      if (entry.notice.message !== message) {
+        entry.notice = { ...entry.notice, message }
+        this.journal.save(entry.notice)
+      }
+      await waitOjakPoll(sample.pollAfterMs, entry.signal)
+    }
+    let released = false
+    let committed = false
+    entry.resolve({
+      signal: entry.signal,
+      submitted: () => {
+        entry.signal.throwIfAborted()
+        entry.notice = { ...entry.notice, phase: 'submitted', message: 'Launch dispatched. If Orca stops now, reconcile the existing process before retrying.' }
+        this.journal.save(entry.notice)
+      },
+      committed: (retainInput) => {
+        if (!retainInput) this.journal.remove(entry.notice.key)
+        committed = true
+      },
+      release: (error) => {
+        if (released) return
+        released = true
+        this.finish(entry, error, committed)
+      }
+    })
+  }
+
+  private finish(entry: Entry, error?: unknown, committed = false): void {
+    entry.cleanup()
+    this.entries.delete(entry.notice.key)
+    if (!committed && entry.notice.phase === 'queued') {
+      try {
+        this.journal.save({ ...entry.notice,
+          phase: entry.cancelled ? 'cancelled' : this.stopped ? 'queued' : entry.signal.aborted ? 'cancelled' : 'failed',
+          message: error instanceof Error ? error.message : 'Ojak launch stopped before dispatch; input is saved.' })
+      } catch (saveError) {
+        error = saveError
+      }
+    }
+    entry.reject(error ?? new Error('Ojak launch stopped before dispatch.'))
+    if (this.active === entry) {
+      this.active = null
+      this.nextStartAt = Date.now() + 2_000
+    }
+    this.pump()
+  }
+}
diff --git a/src/main/agent-launch/ojak-launch-recovery.test.ts b/src/main/agent-launch/ojak-launch-recovery.test.ts
