@@ -0,0 +1,63 @@
+import { mkdtempSync, rmSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterEach, describe, expect, it } from 'vitest'
+import { JournalHostDatabase } from '../native-chat/agent-session-journal/journal-host-database'
+import { OjakLaunchJournal, OJAK_LAUNCH_BYTES, OJAK_LAUNCH_LIMIT } from './ojak-launch-journal'
+import type { OjakLaunchNotice } from '../../shared/ojak-launch-admission'
+
+const databases: JournalHostDatabase[] = []
+const directories: string[] = []
+afterEach(() => {
+  for (const database of databases.splice(0)) database.close()
+  for (const directory of directories.splice(0)) rmSync(directory, { recursive: true, force: true })
+})
+function open(directory?: string) {
+  const path = directory ?? mkdtempSync(join(tmpdir(), 'orca-ojak-journal-'))
+  if (!directory) directories.push(path)
+  const database = JournalHostDatabase.open(path)
+  databases.push(database)
+  return { database, journal: new OjakLaunchJournal(database), path }
+}
+function notice(key: string): OjakLaunchNotice {
+  return { key, owner: { kind: 'terminal', worktreeId: 'folder-1' }, phase: 'queued',
+    message: 'Waiting', savedCommand: 'omp', savedPrompt: `draft-${key}` }
+}
+
+describe('Ojak intent in the host journal', () => {
+  it('retains queued and uncertain intent after reopening without changing other host metadata', () => {
+    const h = open()
+    h.database.db.prepare('INSERT INTO agent_session_store_meta (key, value) VALUES (?, ?)').run('other', 'kept')
+    h.journal.save(notice('queued'))
+    h.journal.save({ ...notice('uncertain'), phase: 'submitted' })
+    h.database.close()
+    const reopened = open(h.path)
+    expect(reopened.journal.list()).toEqual(expect.arrayContaining([
+      expect.objectContaining({ key: 'queued', phase: 'queued', savedPrompt: 'draft-queued' }),
+      expect.objectContaining({ key: 'uncertain', phase: 'submitted', savedPrompt: 'draft-uncertain' })
+    ]))
+    reopened.journal.remove('queued')
+    expect(reopened.journal.list().map((row) => row.key)).toEqual(['uncertain'])
+    expect(reopened.database.db.prepare('SELECT value FROM agent_session_store_meta WHERE key = ?').get('other'))
+      .toEqual({ value: 'kept' })
+  })
+
+  it('enforces the count cap transactionally while allowing cancellation at capacity', () => {
+    const { journal } = open()
+    for (let index = 0; index < OJAK_LAUNCH_LIMIT; index++) journal.save(notice(String(index)))
+    expect(() => journal.save(notice('overflow'))).toThrow(/full/)
+    journal.save({ ...notice('0'), phase: 'cancelled' })
+    expect(journal.list().find((row) => row.key === '0')).toMatchObject({ phase: 'cancelled', savedPrompt: 'draft-0' })
+    expect(journal.list().some((row) => row.key === 'overflow')).toBe(false)
+    journal.remove('0')
+    journal.save(notice('replacement'))
+    expect(journal.list().find((row) => row.key === 'replacement')?.savedPrompt).toBe('draft-replacement')
+  })
+
+  it('counts UTF-8 bytes and preserves prior input after an oversized replacement', () => {
+    const { journal } = open()
+    journal.save(notice('a'))
+    expect(() => journal.save({ ...notice('a'), savedPrompt: '界'.repeat(Math.ceil(OJAK_LAUNCH_BYTES / 3)) })).toThrow(/4 MiB/)
+    expect(journal.list()).toEqual([notice('a')])
+  })
+})
diff --git a/src/main/agent-launch/ojak-launch-journal.ts b/src/main/agent-launch/ojak-launch-journal.ts
