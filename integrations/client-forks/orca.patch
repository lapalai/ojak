+import { AsyncLocalStorage } from 'node:async_hooks'
+import type { OjakLaunchPrompt } from '../../shared/ojak-launch-recovery'
+
+/** Launch text not yet handed to a surface remains available to the pre-spawn journal. */
+export const ojakLaunchPrompt = new AsyncLocalStorage<OjakLaunchPrompt | undefined>()
+
+/** Recovered terminal input stays behind the dispatch fence until its one delivery settles. */
+export const ojakRecoveryDispatch = new AsyncLocalStorage<boolean>()
