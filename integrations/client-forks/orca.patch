@@ -0,0 +1,140 @@
+import { mkdtempSync, rmSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import type { OjakLaunchNotice } from '../../shared/ojak-launch-admission'
+import { JournalHostDatabase } from '../native-chat/agent-session-journal/journal-host-database'
+import { OjakLaunchJournal } from './ojak-launch-journal'
+import { OjakLaunchQueue } from './ojak-launch-queue'
+import { OjakLaunchRecovery } from './ojak-launch-recovery'
+
+const ready = { ready: true, reason: 'ready', pollAfterMs: 500 }
+const pressure = { ready: false, reason: 'resource_pressure', pollAfterMs: 500 }
+const managed = { tokenPath: '/fixture/bridge.token' }
+const databases: JournalHostDatabase[] = []
+const directories: string[] = []
+const queues: OjakLaunchQueue[] = []
+beforeEach(() => vi.useFakeTimers())
+afterEach(async () => {
+  for (const queue of queues.splice(0)) queue.suspend()
+  await vi.runAllTimersAsync()
+  for (const database of databases.splice(0)) database.close()
+  for (const directory of directories.splice(0)) rmSync(directory, { recursive: true, force: true })
+  vi.useRealTimers()
+})
+function open(path = mkdtempSync(join(tmpdir(), 'orca-ojak-recovery-'))) {
+  if (!directories.includes(path)) directories.push(path)
+  const database = JournalHostDatabase.open(path)
+  databases.push(database)
+  const journal = new OjakLaunchJournal(database)
+  const sample = vi.fn(async () => pressure)
+  const queue = new OjakLaunchQueue(journal, sample)
+  queues.push(queue)
+  return { path, database, journal, queue, sample }
+}
+function notice(kind: 'terminal' | 'structured'): OjakLaunchNotice {
+  return { key: kind, phase: 'queued', message: 'Waiting', savedPrompt: 'keep my original input',
+    owner: { kind, worktreeId: 'folder-1', tabId: 'tab-1', sessionId: 'omp_session' },
+    recovery: kind === 'terminal'
+      ? { kind, selection: { version: 1, prompt: { text: 'keep my original input', delivery: 'submit' } } }
+      : { kind, sessionId: 'omp_session' } }
+}
+
+describe.each(['terminal', 'structured'] as const)('%s unsent restart recovery', (kind) => {
+  it('suspends without cancellation and restores exactly once after reopening and capacity recovery', async () => {
+    const first = open()
+    const pending = first.queue.acquire(notice(kind), managed).catch((error: unknown) => error)
+    await vi.advanceTimersByTimeAsync(0)
+    first.queue.suspend()
+    await vi.advanceTimersByTimeAsync(0)
+    expect(await pending).toBeInstanceOf(Error)
+    expect(first.journal.list()[0]).toMatchObject({ phase: 'queued', savedPrompt: 'keep my original input' })
+    first.database.close()
+    const reopened = open(first.path)
+    const delivered: string[] = []
+    const recovery = new OjakLaunchRecovery(reopened.queue, {
+      ownerPresent: async () => true,
+      launch: async (row) => {
+        const ticket = await reopened.queue.acquire(row, managed)
+        ticket.submitted()
+        delivered.push(row.savedPrompt!)
+        ticket.committed()
+        ticket.release()
+      }
+    })
+    const restored = recovery.restore()
+    await vi.advanceTimersByTimeAsync(0)
+    await recovery.restore()
+    expect(delivered).toEqual([])
+    reopened.sample.mockResolvedValue(ready)
+    await vi.advanceTimersByTimeAsync(500)
+    await restored
+    expect(delivered).toEqual(['keep my original input'])
+    expect(reopened.journal.list()).toEqual([])
+  })
+
+  it('never resurrects an explicit cancellation or a submitted-but-unconfirmed launch', async () => {
+    const first = open()
+    const pending = first.queue.acquire(notice(kind), managed).catch((error: unknown) => error)
+    first.queue.cancel(kind)
+    await vi.advanceTimersByTimeAsync(0)
+    await pending
+    first.journal.save({ ...notice(kind), key: 'uncertain', phase: 'submitted' })
+    first.database.close()
+    const reopened = open(first.path)
+    reopened.sample.mockResolvedValue(ready)
+    const launch = vi.fn(async () => {})
+    const recovery = new OjakLaunchRecovery(reopened.queue, { ownerPresent: async () => true, launch })
+    await recovery.restore()
+    await expect(recovery.resume(kind, 'folder-1')).rejects.toThrow(/unsent/)
+    await expect(recovery.resume('uncertain', 'folder-1')).rejects.toThrow(/unsent/)
+    expect(launch).not.toHaveBeenCalled()
+    expect(reopened.journal.list().map((row) => row.phase).sort()).toEqual(['cancelled', 'submitted'])
+  })
+
+  it('keeps a closed owner unsent until an explicit target is selected', async () => {
+    const h = open()
+    h.journal.save(notice(kind))
+    const targets: (string | undefined)[] = []
+    const recovery = new OjakLaunchRecovery(h.queue, {
+      ownerPresent: async () => false,
+      launch: async (_row, target) => { targets.push(target) }
+    })
+    await recovery.restore()
+    expect(targets).toEqual([])
+    expect(h.journal.list()[0]?.phase).toBe('queued')
+    await recovery.resume(kind, 'folder-1')
+    expect(targets).toEqual(['folder-1'])
+  })
+
+  it('does not start after cancellation or shutdown lands during owner validation', async () => {
+    const h = open()
+    h.journal.save(notice(kind))
+    const owner = Promise.withResolvers<boolean>()
+    const launch = vi.fn(async () => {})
+    const recovery = new OjakLaunchRecovery(h.queue, { ownerPresent: () => owner.promise, launch })
+    const restoring = recovery.restore()
+    h.queue.cancel(kind)
+    owner.resolve(true)
+    await restoring
+    expect(launch).not.toHaveBeenCalled()
+    h.journal.save(notice(kind))
+    h.queue.suspend()
+    await recovery.restore()
+    expect(launch).not.toHaveBeenCalled()
+  })
+})
+
+it('moves an orphan atomically and refuses to move cancelled or occupied intent', () => {
+  const h = open()
+  h.journal.save(notice('terminal'))
+  const replacement = { ...notice('terminal'), key: 'terminal:new-pane', owner: {
+    kind: 'terminal' as const, worktreeId: 'folder-2', tabId: 'new-tab', paneKey: 'new-tab:new-leaf'
+  } }
+  h.queue.retarget('terminal', replacement)
+  expect(h.journal.list()).toEqual([replacement])
+  expect(() => h.queue.retarget('terminal', replacement)).toThrow(/changed/)
+  h.queue.cancel(replacement.key)
+  expect(() => h.queue.retarget(replacement.key, { ...replacement, key: 'other' })).toThrow(/changed/)
+  expect(h.journal.list()).toEqual([expect.objectContaining({ key: replacement.key, phase: 'cancelled' })])
+})
