new file mode 100644
index 00000000..2baa6e69
--- /dev/null
+++ b/src/shared/ojak-launch-recovery.ts
@@ -0,0 +1,29 @@
+import { z } from 'zod'
+
+export const ojakLaunchPromptSchema = z.object({
+  text: z.string(),
+  delivery: z.enum(['submit', 'draft']),
+})
+
+/** Selection, not executable text: recovery reads commands, permissions and credentials anew. */
+export const ojakTerminalSelectionSchema = z.object({
+  version: z.literal(1),
+  prompt: ojakLaunchPromptSchema,
+  sessionOptions: z.record(z.string(), z.union([z.string(), z.boolean()])).optional()
+})
+export type OjakTerminalSelection = z.infer<typeof ojakTerminalSelectionSchema>
+
+export const ojakLaunchRecoverySchema = z.discriminatedUnion('kind', [
+  z.object({
+    kind: z.literal('terminal'),
+    selection: ojakTerminalSelectionSchema,
+    cwd: z.string().optional(),
+    shellOverride: z.string().optional()
+  }),
+  z.object({
+    kind: z.literal('structured'),
+    sessionId: z.string()
+  })
+])
+export type OjakLaunchRecoveryIntent = z.infer<typeof ojakLaunchRecoverySchema>
+export type OjakLaunchPrompt = z.infer<typeof ojakLaunchPromptSchema>
