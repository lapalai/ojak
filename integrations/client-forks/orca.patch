+import type { OjakLaunchRecoveryIntent } from './ojak-launch-recovery'
+
+export type OjakLaunchOwner = {
+  kind: 'terminal' | 'structured'
+  worktreeId: string
+  tabId?: string
+  paneKey?: string
+  sessionId?: string
+}
+
+export type OjakLaunchNotice = {
+  key: string
+  owner: OjakLaunchOwner
+  phase: 'queued' | 'submitted' | 'cancelled' | 'failed'
+  message: string
+  /** Unsent launch command only; never the environment or bridge token. */
+  savedCommand?: string
+  savedPrompt?: string
+  recovery?: OjakLaunchRecoveryIntent
+  /** Ownership commit alone cannot settle a recovered terminal's pending prompt delivery. */
+  deliveryPending?: boolean
+  /** Transient host state, not persisted. */
+  waiting?: boolean
+}
