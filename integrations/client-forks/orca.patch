@@ -0,0 +1,97 @@
+import { useEffect, useState } from 'react'
+import type { OjakLaunchNotice } from '../../../../shared/ojak-launch-admission'
+import { Button } from '@/components/ui/button'
+import { translate } from '@/i18n/i18n'
+
+/** The local execution host owns this state; remote panes never mount this notice. */
+export function OjakLaunchNoticePanel({ worktreeId, tabId, sessionId }: {
+  worktreeId?: string
+  tabId?: string
+  sessionId?: string
+}): React.JSX.Element | null {
+  const [notices, setNotices] = useState<OjakLaunchNotice[]>([])
+  const [error, setError] = useState<string | null>(null)
+  const [pendingKey, setPendingKey] = useState<string | null>(null)
+  useEffect(() => {
+    const read = window.api?.pty?.ojakLaunchNotices
+    if (!read) return
+    let disposed = false
+    let timer: ReturnType<typeof setTimeout> | undefined
+    const refresh = async (): Promise<void> => {
+      try {
+        const rows = await read()
+        if (!disposed) setNotices(rows)
+      } catch (failure) {
+        if (!disposed) setError(failure instanceof Error ? failure.message : String(failure))
+      } finally {
+        if (!disposed) timer = setTimeout(() => void refresh(), 1_000)
+      }
+    }
+    void refresh()
+    return () => { disposed = true; clearTimeout(timer) }
+  }, [worktreeId, tabId, sessionId])
+  if (notices.length === 0) return null
+  const ownsNotice = (row: OjakLaunchNotice): boolean => sessionId
+    ? row.owner.kind === 'structured' && row.owner.sessionId === sessionId
+    : row.owner.kind === 'terminal' && row.owner.worktreeId === worktreeId && row.owner.tabId === tabId
+  const current = notices.filter(ownsNotice)
+  const others = notices.filter((row) => !ownsNotice(row))
+  const act = async (notice: OjakLaunchNotice, action: 'copy' | 'resume' | 'cancel' = 'cancel'): Promise<void> => {
+    setPendingKey(notice.key)
+    try {
+      if (action === 'copy') await window.api.ui.writeClipboardText(notice.savedPrompt || notice.savedCommand || '')
+      else if (action === 'resume' && worktreeId) await window.api.pty.ojakResumeLaunch?.(notice.key, worktreeId)
+      else if (notice.phase === 'queued') await window.api.pty.ojakCancelLaunch?.(notice.key)
+      else await window.api.pty.ojakDismissLaunch?.(notice.key)
+      setNotices(await window.api.pty.ojakLaunchNotices?.() ?? [])
+      setError(null)
+    } catch (failure) {
+      setError(failure instanceof Error ? failure.message : String(failure))
+    } finally {
+      setPendingKey(null)
+    }
+  }
+  const renderNotice = (notice: OjakLaunchNotice): React.JSX.Element => (
+    <div key={notice.key} className="flex flex-wrap items-start gap-2">
+      <span className="min-w-0 flex-1 break-words">{notice.message}</span>
+      {notice.savedPrompt || notice.savedCommand ? (
+        <Button variant="outline" size="xs" disabled={pendingKey === notice.key} onClick={() => void act(notice, 'copy')}>
+          {translate('ojak.launch.copyInput', 'Copy saved input')}
+        </Button>
+      ) : null}
+      {notice.phase === 'queued' && !notice.waiting && notice.recovery && worktreeId ? (
+        <Button variant="outline" size="xs"
+          disabled={pendingKey === notice.key || (notice.recovery.kind === 'structured' && notice.owner.worktreeId !== worktreeId)}
+          onClick={() => void act(notice, 'resume')}>
+          {translate('ojak.launch.resumeHere', 'Resume in this workspace')}
+        </Button>
+      ) : null}
+      {notice.phase !== 'submitted' ? (
+        <Button variant="ghost" size="xs" disabled={pendingKey === notice.key} onClick={() => void act(notice)}>
+          {notice.phase === 'queued' ? translate('ojak.launch.cancel', 'Cancel') : translate('ojak.launch.dismiss', 'Dismiss')}
+        </Button>
+      ) : null}
+    </div>
+  )
+  return (
+    <div className={`pointer-events-auto absolute inset-x-3 ${sessionId ? 'top-3' : 'bottom-3'} z-50 flex max-h-60 flex-col gap-2 overflow-y-auto rounded-md border border-border bg-popover px-3.5 py-2.5 text-xs text-popover-foreground shadow-floating`} role="status">
+      {current.map(renderNotice)}
+      {others.length > 0 ? (
+        <details>
+          <summary className="cursor-pointer rounded-md px-2 py-1 hover:bg-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
+            {translate('ojak.launch.otherSaved', 'Other saved Ojak launches')}
+          </summary>
+          <div className="flex flex-col gap-3 py-2">
+            {others.map((notice) => (
+              <div key={notice.key} className="flex flex-col gap-1">
+                <span className="break-all text-muted-foreground">{notice.owner.sessionId || notice.owner.paneKey || notice.owner.worktreeId}</span>
+                {renderNotice(notice)}
+              </div>
+            ))}
+          </div>
+        </details>
+      ) : null}
+      {error ? <span>{error}</span> : null}
+    </div>
+  )
+}
