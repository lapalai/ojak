index 00000000..9f772f3a
--- /dev/null
+++ b/src/main/agent-launch/ojak-launch-admission.ts
@@ -0,0 +1,84 @@
+import { getProfileUserDataPath } from '../orca-profiles/profile-storage-paths'
+import { LOCAL_EXECUTION_HOST_ID } from '../../shared/execution-host'
+import type { OjakLaunchNotice, OjakLaunchOwner } from '../../shared/ojak-launch-admission'
+import { createStructuredAgentSessionLogger } from '../native-chat/agent-session-wire/structured-agent-session-logger'
+import type { JournalHostDatabase } from '../native-chat/agent-session-journal/journal-host-database'
+import { openAgentSessionRecordStoreOnce } from '../runtime/agent-session-record-store-slot'
+import { resolveOjakManagedLaunch } from './ojak-managed-launch'
+import { OjakLaunchJournal } from './ojak-launch-journal'
+import { OjakLaunchQueue, type OjakLaunchTicket } from './ojak-launch-queue'
+import { ojakLaunchPrompt, ojakRecoveryDispatch } from './ojak-launch-prompt'
+import type { OjakLaunchRecoveryIntent } from '../../shared/ojak-launch-recovery'
+
+let installed: { database: JournalHostDatabase; queue: OjakLaunchQueue } | undefined
+
+export async function ojakLaunchQueue(database?: JournalHostDatabase): Promise<OjakLaunchQueue> {
+  const journal = database ?? (await openAgentSessionRecordStoreOnce({
+    stateDirectory: getProfileUserDataPath(),
+    hostId: LOCAL_EXECUTION_HOST_ID,
+    logger: createStructuredAgentSessionLogger()
+  })).journalDatabase
+  if (installed?.database !== journal) {
+    installed?.queue.suspend()
+    installed = { database: journal, queue: new OjakLaunchQueue(new OjakLaunchJournal(journal)) }
+  }
+  return installed.queue
+}
+
+export function stopOjakLaunchWaiting(): void {
+  installed?.queue.suspend()
+}
+
+export async function acquireOjakLaunch(input: {
+  agent?: string
+  command?: string
+  env: NodeJS.ProcessEnv
+  local: boolean
+  key: string
+  owner: OjakLaunchOwner
+  savedCommand?: string
+  signal?: AbortSignal
+  savedPrompt?: string
+  recovery?: OjakLaunchRecoveryIntent
+  database?: JournalHostDatabase
+}): Promise<OjakLaunchTicket | null> {
+  const managed = await resolveOjakManagedLaunch(input)
+  if (!managed) {
+    if (installed?.queue.notices().some((row) => row.key === input.key)) {
+      throw new Error('This pane has a saved Ojak launch. Use its waiting or recovery controls before starting another process.')
+    }
+    return null
+  }
+  const queue = await ojakLaunchQueue(input.database)
+  const retainInput = ojakRecoveryDispatch.getStore()
+  const notice: OjakLaunchNotice = {
+    key: input.key,
+    owner: input.owner,
+    phase: 'queued',
+    message: 'Waiting for Ojak admission. Input is saved; no agent has started.',
+    ...(input.savedCommand ? { savedCommand: input.savedCommand } : {}),
+    ...(input.recovery ? { recovery: input.recovery } : {}),
+    ...(retainInput ? { deliveryPending: true } : {}),
+    ...(input.savedPrompt || ojakLaunchPrompt.getStore()?.text
+      ? { savedPrompt: input.savedPrompt || ojakLaunchPrompt.getStore()?.text } : {})
+  }
+  const ticket = await queue.acquire(notice, managed, input.signal)
+  return retainInput ? { ...ticket, committed: () => ticket.committed(true) } : ticket
+}
+
+export async function settleOjakTerminalLaunch(worktreeId: string | undefined, paneKey: string | undefined): Promise<void> {
+  if (!worktreeId || !paneKey || !installed) return
+  const key = `terminal:${worktreeId}:${paneKey}`
+  const journal = new OjakLaunchJournal(installed.database)
+  if (journal.list().some((row) => row.key === key && row.phase === 'submitted' && !row.deliveryPending)) journal.remove(key)
+}
+
+export function cancelOjakTerminalLaunches(worktreeId: string, tabId: string, paneKey?: string): void {
+  if (!installed) return
+  for (const notice of installed.queue.notices()) {
+    if (notice.owner.kind === 'terminal' && notice.owner.worktreeId === worktreeId &&
+      notice.owner.tabId === tabId && (!paneKey || notice.owner.paneKey === paneKey)) {
+      installed.queue.cancel(notice.key)
+    }
+  }
+}
