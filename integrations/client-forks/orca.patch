+import { createHash } from 'node:crypto'
+import { mkdtemp, mkdir, rm, writeFile } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { readOjakAdmission, resolveOjakManagedLaunch } from './ojak-managed-launch'
+
+const directories: string[] = []
+afterEach(async () => {
+  await Promise.all(directories.splice(0).map((path) => rm(path, { recursive: true, force: true })))
+})
+async function fixture() {
+  const home = await mkdtemp(join(tmpdir(), 'orca-ojak-owned-'))
+  directories.push(home)
+  const agentDir = join(home, '.omp', 'agent')
+  const extensionDir = join(agentDir, 'extensions', 'aam-accounts')
+  await mkdir(extensionDir, { recursive: true })
+  const source = `const INSTALLED_AAM_HOME = ${JSON.stringify(home)};\n`
+  await writeFile(join(extensionDir, 'index.js'), source)
+  await writeFile(join(extensionDir, '.aam-owner.json'), JSON.stringify({
+    owner: 'ai-account-manager.omp-accounts.v1', version: 1,
+    sha256: createHash('sha256').update(source).digest('hex')
+  }))
+  const tokenPath = join(home, 'bridge.token')
+  await writeFile(tokenPath, 'fixture-token\n')
+  return { home, agentDir, extensionDir, tokenPath,
+    input: { agent: 'omp', command: 'omp', local: true, env: { HOME: home, USERPROFILE: home } } }
+}
+
+describe('Ojak-owned local omp detection', () => {
+  it('uses the verified extension home ahead of ambient AAM_HOME', async () => {
+    const h = await fixture()
+    expect(await resolveOjakManagedLaunch({ ...h.input, env: { ...h.input.env, AAM_HOME: '/other' } }))
+      .toEqual({ tokenPath: h.tokenPath })
+    expect(await resolveOjakManagedLaunch({ ...h.input, agent: 'pi', command: 'omp --mode rpc' }))
+      .toEqual({ tokenPath: h.tokenPath })
+  })
+
+  it('does not gate unrelated agents, remote hosts, or AAM_HOME alone', async () => {
+    const h = await fixture()
+    expect(await resolveOjakManagedLaunch({ ...h.input, agent: 'pi', command: 'pi' })).toBeNull()
+    expect(await resolveOjakManagedLaunch({ ...h.input, local: false })).toBeNull()
+    expect(await resolveOjakManagedLaunch({ ...h.input, env: {
+      ...h.input.env, PI_CODING_AGENT_DIR: join(h.home, 'unmanaged'), AAM_HOME: h.home
+    } })).toBeNull()
+  })
+
+  it('finds the actual Orca source root and fails closed after owned source changes', async () => {
+    const h = await fixture()
+    expect(await resolveOjakManagedLaunch({ ...h.input, env: {
+      ORCA_OMP_SOURCE_AGENT_DIR: h.agentDir, PI_CODING_AGENT_DIR: '/stale-overlay'
+    } })).toEqual({ tokenPath: h.tokenPath })
+    await writeFile(join(h.extensionDir, 'index.js'), 'changed')
+    await expect(resolveOjakManagedLaunch(h.input)).rejects.toThrow(/ownership changed/)
+  })
+})
+
+describe('authenticated admission samples', () => {
+  it('uses GET with authentication, a deadline, and bounded polling hints', async () => {
+    const h = await fixture()
+    const request = vi.fn<typeof fetch>().mockResolvedValue(new Response(JSON.stringify({
+      version: 1, ready: false, reason: 'resource_pressure', poll_after_ms: 1
+    })))
+    expect(await readOjakAdmission(h, new AbortController().signal, request)).toEqual({
+      ready: false, reason: 'resource_pressure', pollAfterMs: 500
+    })
+    expect(request).toHaveBeenCalledWith('http://127.0.0.1:4020/v1/admission', expect.objectContaining({
+      headers: { Authorization: 'Bearer fixture-token' }, redirect: 'error', signal: expect.any(AbortSignal)
+    }))
+  })
+
+  it('waits on transport loss but exposes authentication and protocol failures', async () => {
+    const h = await fixture()
+    const request = vi.fn<typeof fetch>().mockRejectedValue(new TypeError('connection refused'))
+    const signal = new AbortController().signal
+    expect(await readOjakAdmission(h, signal, request)).toMatchObject({ ready: false, reason: 'service_unavailable' })
+    request.mockResolvedValueOnce(new Response('', { status: 401 }))
+    await expect(readOjakAdmission(h, signal, request)).rejects.toThrow(/401/)
+    request.mockResolvedValueOnce(new Response(JSON.stringify({ version: 1, ready: true,
+      reason: 'resource_pressure', poll_after_ms: 2000 })))
+    await expect(readOjakAdmission(h, signal, request)).rejects.toThrow(/inconsistent/)
+  })
+
+  it('waits when the response body disconnects but rejects malformed JSON', async () => {
+    const h = await fixture()
+    const brokenBody = new ReadableStream({
+      start: (controller) => controller.error(new TypeError('socket closed'))
+    })
+    const request = vi.fn<typeof fetch>().mockResolvedValueOnce(new Response(brokenBody))
+    const signal = new AbortController().signal
+    expect(await readOjakAdmission(h, signal, request)).toMatchObject({ ready: false, reason: 'service_unavailable' })
+    request.mockResolvedValueOnce(new Response('not JSON'))
+    await expect(readOjakAdmission(h, signal, request)).rejects.toThrow(/invalid JSON/)
+  })
+
+  it('waits on a proven admission-control 503 but refuses an unproven 503', async () => {
+    const h = await fixture()
+    const signal = new AbortController().signal
+    const request = vi.fn<typeof fetch>().mockResolvedValueOnce(new Response(JSON.stringify({
+      error: { type: 'admission_wait', code: 'BRIDGE_BUSY', submitted: false }
+    }), { status: 503 }))
+    expect(await readOjakAdmission(h, signal, request)).toMatchObject({
+      ready: false, reason: 'admission_control_saturated', pollAfterMs: 2000
+    })
+    for (const error of [
+      { type: 'admission_wait', code: 'BRIDGE_BUSY', submitted: true },
+      { type: 'admission_wait', code: 'BRIDGE_UNAVAILABLE', submitted: false },
+      { type: 'server_error', code: 'BRIDGE_UNAVAILABLE', submitted: false },
+      { type: 'admission_wait', code: 'BRIDGE_UNAVAILABLE' }
+    ]) {
+      request.mockResolvedValueOnce(new Response(JSON.stringify({ error }), { status: 503 }))
+      await expect(readOjakAdmission(h, signal, request)).rejects.toThrow(/503/)
+    }
+  })
+
+  it('never reads a token or polls for an already cancelled acquire', async () => {
+    const stop = new AbortController()
+    stop.abort(new Error('cancelled'))
+    const request = vi.fn<typeof fetch>()
+    await expect(readOjakAdmission({ tokenPath: '/absent' }, stop.signal, request)).rejects.toThrow('cancelled')
+    expect(request).not.toHaveBeenCalled()
+  })
+})
diff --git a/src/main/agent-launch/ojak-managed-launch.ts b/src/main/agent-launch/ojak-managed-launch.ts
new file mode 100644
index 00000000..ca26aa4b
--- /dev/null
+++ b/src/main/agent-launch/ojak-managed-launch.ts
@@ -0,0 +1,105 @@
+import { createHash } from 'node:crypto'
+import { readFile } from 'node:fs/promises'
+import { homedir } from 'node:os'
+import { join } from 'node:path'
+import { z } from 'zod'
+import { detectExplicitPiAgentKindFromCommand } from '../../shared/pi-agent-kind'
+
+const ownerSchema = z.object({
+  owner: z.literal('ai-account-manager.omp-accounts.v1'),
+  version: z.literal(1),
+  sha256: z.string().regex(/^[a-f0-9]{64}$/)
+})
+
+export type OjakManagedLaunch = { tokenPath: string }
+
+async function optionalFile(path: string): Promise<string | null> {
+  try {
+    return await readFile(path, 'utf8')
+  } catch (error) {
+    if (error instanceof Error && 'code' in error && error.code === 'ENOENT') return null
+    throw error
+  }
+}
+
+/** Presence of a verified, Ojak-owned accounts extension is the integration opt-in, not AAM_HOME. */
+export async function resolveOjakManagedLaunch(input: {
+  agent?: string
+  command?: string
+  env: NodeJS.ProcessEnv
+  local: boolean
+}): Promise<OjakManagedLaunch | null> {
+  if (!input.local) return null
+  const kind = detectExplicitPiAgentKindFromCommand(input.command)
+  if (input.agent !== 'omp' && kind !== 'omp') return null
+  const home = input.env.HOME || input.env.USERPROFILE || homedir()
+  const agentDir = input.env.ORCA_OMP_SOURCE_AGENT_DIR || input.env.PI_CODING_AGENT_DIR ||
+    join(home, input.env.PI_CONFIG_DIR || '.omp', 'agent')
+  const extensionDir = join(agentDir, 'extensions', 'aam-accounts')
+  const marker = await optionalFile(join(extensionDir, '.aam-owner.json'))
+  if (marker === null) return null
+  const owner = ownerSchema.safeParse(JSON.parse(marker))
+  if (!owner.success) return null
+  const source = await optionalFile(join(extensionDir, 'index.js'))
+  if (source === null || createHash('sha256').update(source).digest('hex') !== owner.data.sha256) {
+    throw new Error('Ojak accounts extension ownership changed. Repair the omp integration in Ojak before launching.')
+  }
+  // The installed extension pins its home ahead of AAM_HOME; never evaluate extension code here.
+  const installed = /^const INSTALLED_AAM_HOME = ("(?:[^"\\]|\\.)*"|null);$/m.exec(source)
+  if (!installed) throw new Error('Ojak accounts extension has no readable installation home. Update its integration.')
+  const pinned: unknown = JSON.parse(installed[1]!)
+  const aamHome = typeof pinned === 'string' ? pinned : input.env.AAM_HOME ||
+    join(home, 'Library', 'Application Support', 'AI Account Manager')
+  return { tokenPath: join(aamHome, 'bridge.token') }
+}
+
+const sampleSchema = z.object({
+  version: z.literal(1),
+  ready: z.boolean(),
+  reason: z.enum(['ready', 'resource_pressure', 'resource_unknown', 'model_capacity']),
+  poll_after_ms: z.number().int().positive()
+})
+
+const controlSaturationSchema = z.object({ error: z.object({
+  type: z.literal('admission_wait'),
+  code: z.enum(['BRIDGE_BUSY', 'BRIDGE_QUEUE_TIMEOUT', 'BRIDGE_RESOURCE_PRESSURE']),
+  submitted: z.literal(false)
+}) })
+
+export type OjakAdmissionSample = { ready: boolean; reason: string; pollAfterMs: number }
+
+export async function readOjakAdmission(
+  managed: OjakManagedLaunch,
+  signal: AbortSignal,
+  request: typeof fetch = fetch
+): Promise<OjakAdmissionSample> {
+  signal.throwIfAborted()
+  const token = (await readFile(managed.tokenPath, 'utf8')).trim()
+  if (!token) throw new Error('Ojak bridge token is empty. Repair the omp integration in Ojak.')
+  let response: Response
+  let body: unknown
+  try {
+    response = await request('http://127.0.0.1:4020/v1/admission', {
+      headers: { Authorization: `Bearer ${token}` },
+      signal: AbortSignal.any([signal, AbortSignal.timeout(3_000)]),
+      redirect: 'error'
+    })
+    if (response.ok || response.status === 503) body = await response.json()
+  } catch (error) {
+    signal.throwIfAborted()
+    if (error instanceof SyntaxError) {
+      throw new Error('Ojak admission returned invalid JSON. Check the Ojak service configuration.')
+    }
+    return { ready: false, reason: 'service_unavailable', pollAfterMs: 2_000 }
+  }
+  if (response.status === 503 && controlSaturationSchema.safeParse(body).success) {
+    return { ready: false, reason: 'admission_control_saturated', pollAfterMs: 2_000 }
+  }
+  if (!response.ok) {
+    if (!response.bodyUsed) await response.body?.cancel()
+    throw new Error(`Ojak admission refused (${response.status}). Check Ojak authentication and integration; no agent was launched.`)
+  }
+  const sample = sampleSchema.parse(body)
+  if (sample.ready !== (sample.reason === 'ready')) throw new Error('Ojak admission returned an inconsistent readiness sample.')
+  return { ready: sample.ready, reason: sample.reason, pollAfterMs: Math.max(500, Math.min(10_000, sample.poll_after_ms)) }
+}
