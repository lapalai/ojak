+import type { StructuredAgentSessionAcquireInput } from '../native-chat/agent-session-wire/structured-agent-session-adapter'
+import type { JournalHostDatabase } from '../native-chat/agent-session-journal/journal-host-database'
+import { acquireOjakLaunch } from './ojak-launch-admission'
+import type { OjakLaunchTicket } from './ojak-launch-queue'
+
+export type StructuredLaunchAdmission = (
+  input: StructuredAgentSessionAcquireInput,
+  launch: { command: string; env?: NodeJS.ProcessEnv }
+) => Promise<OjakLaunchTicket | null>
+
+export function structuredOjakLaunchAdmission(database: JournalHostDatabase): StructuredLaunchAdmission {
+  return (input, launch) => acquireOjakLaunch({
+    agent: input.identity.agent,
+    command: launch.command,
+    env: launch.env ?? {},
+    local: input.launch?.location.executionHostId === 'local' && input.launch.location.wslDistro === null,
+    key: `structured:${input.identity.sessionId}`,
+    owner: { kind: 'structured', worktreeId: input.identity.workspaceId, sessionId: input.identity.sessionId },
+    recovery: { kind: 'structured', sessionId: input.identity.sessionId },
+    signal: input.signal,
+    database
+  })
+}
