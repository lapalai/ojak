@@ -0,0 +1,52 @@
+import type { PtySpawnOptions } from '../providers/types'
+import { resolveSetupAgentSequenceLaunchCommand } from '../../shared/setup-agent-sequencing'
+import { acquireOjakLaunch, settleOjakTerminalLaunch } from './ojak-launch-admission'
+import type { OjakLaunchTicket } from './ojak-launch-queue'
+import { OJAK_TERMINAL_SELECTION_ENV } from '../../shared/ojak-terminal-selection'
+import { ojakTerminalSelectionSchema } from '../../shared/ojak-launch-recovery'
+import { ojakLaunchPrompt } from './ojak-launch-prompt'
+
+const tickets = new WeakMap<PtySpawnOptions, OjakLaunchTicket>()
+
+/** Called only after stable-pane/claim reconciliation has authorized a fresh local spawn. */
+export async function admitOjakPtySpawn(options: PtySpawnOptions, local: boolean): Promise<void> {
+  const command = resolveSetupAgentSequenceLaunchCommand(options.env ?? {}, options.command)
+  const paneKey = options.paneKey
+  const worktreeId = options.worktreeId
+  const selectionText = options.env?.[OJAK_TERMINAL_SELECTION_ENV]
+  const selection = selectionText ? ojakTerminalSelectionSchema.parse(JSON.parse(selectionText)) : undefined
+  if (selection && ojakLaunchPrompt.getStore()) selection.prompt = ojakLaunchPrompt.getStore()!
+  if (options.env) delete options.env[OJAK_TERMINAL_SELECTION_ENV]
+  const admission = await acquireOjakLaunch({
+    agent: options.launchAgent,
+    command,
+    env: { ...process.env, ...options.env },
+    local: local && !options.attachOnly,
+    key: `terminal:${worktreeId ?? ''}:${paneKey ?? options.sessionId ?? ''}`,
+    owner: { kind: 'terminal', worktreeId: worktreeId ?? '',
+      ...(options.tabId ? { tabId: options.tabId } : {}), ...(paneKey ? { paneKey } : {}) },
+    savedCommand: 'omp',
+    ...(selection ? { recovery: { kind: 'terminal' as const, selection,
+      ...(options.cwd ? { cwd: options.cwd } : {}),
+      ...(options.shellOverride ? { shellOverride: options.shellOverride } : {}) } } : {}),
+    signal: options.signal,
+    savedPrompt: selection?.prompt.text ?? options.env?.ORCA_OMP_PREFILL
+  })
+  if (!admission) return
+  tickets.set(options, admission)
+  options.signal = admission.signal
+  // Persist the uncertainty fence before handing control to the process owner.
+  admission.submitted()
+}
+
+export async function commitOjakPtySpawn(options: PtySpawnOptions): Promise<void> {
+  const ticket = tickets.get(options)
+  if (ticket) ticket.committed()
+  else await settleOjakTerminalLaunch(options.worktreeId, options.paneKey)
+}
+
+export function releaseOjakPtySpawn(options: PtySpawnOptions): void {
+  const ticket = tickets.get(options)
+  tickets.delete(options)
+  ticket?.release()
+}
