--- /dev/null
+++ b/src/main/agent-launch/ojak-launch-journal.ts
@@ -0,0 +1,63 @@
+import { z } from 'zod'
+import type { OjakLaunchNotice } from '../../shared/ojak-launch-admission'
+import type { JournalHostDatabase } from '../native-chat/agent-session-journal/journal-host-database'
+import { ojakLaunchRecoverySchema } from '../../shared/ojak-launch-recovery'
+
+const PREFIX = 'ojak-launch:'
+export const OJAK_LAUNCH_LIMIT = 32
+export const OJAK_LAUNCH_BYTES = 4 * 1024 * 1024
+const noticeSchema = z.object({
+  key: z.string(),
+  owner: z.object({
+    kind: z.enum(['terminal', 'structured']),
+    worktreeId: z.string(),
+    tabId: z.string().optional(),
+    paneKey: z.string().optional(),
+    sessionId: z.string().optional()
+  }),
+  phase: z.enum(['queued', 'submitted', 'cancelled', 'failed']),
+  message: z.string(),
+  savedCommand: z.string().optional(),
+  savedPrompt: z.string().optional(),
+  deliveryPending: z.boolean().optional(),
+  recovery: ojakLaunchRecoverySchema.optional()
+})
+
+/** Uses the existing host journal connection and transaction boundary, not a second file/store. */
+export class OjakLaunchJournal {
+  constructor(private readonly database: JournalHostDatabase) {}
+
+  list(): OjakLaunchNotice[] {
+    return this.database.db.prepare('SELECT value FROM agent_session_store_meta WHERE key LIKE ?')
+      .all(`${PREFIX}%`).map((row) => {
+        if (typeof row.value !== 'string') throw new Error('Ojak launch journal is unreadable')
+        return noticeSchema.parse(JSON.parse(row.value))
+      })
+  }
+
+  save(notice: OjakLaunchNotice, replacesKey?: string): void {
+    if (this.database.readOnly) throw new Error('The launch journal is read-only; no agent was launched.')
+    const value = JSON.stringify(noticeSchema.parse(notice))
+    this.database.transaction((db) => {
+      const rows = this.list()
+      if (replacesKey !== undefined && (rows.find((row) => row.key === replacesKey)?.phase !== 'queued' ||
+        rows.some((row) => row.key === notice.key))) throw new Error('Saved launch changed during recovery.')
+      const other = rows.filter((row) => row.key !== notice.key && row.key !== replacesKey)
+      // Refused/cancelled intents stay available for copying, but never run on recovery.
+      const bytes = other.reduce((sum, row) => sum + Buffer.byteLength(JSON.stringify(row)), 0)
+      if (other.length >= OJAK_LAUNCH_LIMIT || bytes + Buffer.byteLength(value) > OJAK_LAUNCH_BYTES) {
+        throw new Error('Ojak launch queue is full (32 saved launches / 4 MiB). Cancel and dismiss an unsent launch before trying again; keep your original draft.')
+      }
+      if (replacesKey !== undefined) db.prepare('DELETE FROM agent_session_store_meta WHERE key = ?').run(`${PREFIX}${replacesKey}`)
+      db.prepare('INSERT OR REPLACE INTO agent_session_store_meta (key, value) VALUES (?, ?)')
+        .run(`${PREFIX}${notice.key}`, value)
+    })
+  }
+
+  remove(key: string): void {
+    if (this.database.readOnly) throw new Error('The launch journal is read-only.')
+    this.database.transaction((db) => {
+      db.prepare('DELETE FROM agent_session_store_meta WHERE key = ?').run(`${PREFIX}${key}`)
+    })
+  }
+}
