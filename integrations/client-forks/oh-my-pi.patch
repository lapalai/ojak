+import { afterEach, expect, it } from "bun:test";
+import { registerCustomApi, unregisterCustomApis } from "@oh-my-pi/pi-ai";
+import { createMockModel } from "@oh-my-pi/pi-ai/providers/mock";
+import { completeSimple, streamSimple } from "@oh-my-pi/pi-ai/stream";
+import type { Api, Context, Model, SimpleStreamOptions } from "@oh-my-pi/pi-ai/types";
+import { AssistantMessageEventStream } from "@oh-my-pi/pi-ai/utils/event-stream";
+
+const SOURCE = "provider-request-ownership-test";
+const API = SOURCE as Api;
+afterEach(() => unregisterCustomApis(SOURCE));
+
+it("admits one-shot side requests without mistaking a missing primary owner for ephemeral work", async () => {
+	const mock = createMockModel({ responses: [{ content: ["side reply"] }] });
+	const model: Model = { ...mock, api: API };
+	const context: Context = { messages: [{ role: "user", content: "classify this", timestamp: 1 }] };
+	registerCustomApi(API, (requestModel: Model, requestContext: Context, options?: SimpleStreamOptions) => {
+		if (options?.requestKind !== "ephemeral") {
+			const rejected = new AssistantMessageEventStream();
+			rejected.fail(new Error("Primary or unknown request requires a durable owner"));
+			return rejected;
+		}
+		return mock.stream(requestModel, requestContext, options);
+	}, SOURCE);
+
+	const side = await completeSimple(model, context, { apiKey: "test" });
+	expect(side.content).toEqual([{ type: "text", text: "side reply" }]);
+	await expect(completeSimple(model, context, { apiKey: "test", requestKind: "primary", sessionId: "unbound" }))
+		.rejects.toThrow("durable owner");
+	await expect(streamSimple(model, context, { apiKey: "test", sessionId: "unbound" }).result())
+		.rejects.toThrow("durable owner");
+	expect(mock.calls).toHaveLength(1);
+});
