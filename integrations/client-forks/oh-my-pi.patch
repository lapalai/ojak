+) {
+	const dir = TempDir.createSync("@pi-pending-turn-");
+	dirs.push(dir);
+	const manager = options.manager ?? SessionManager.create(dir.path(), dir.path());
+	const mock = createMockModel(options.model ?? { responses: [{ content: ["complete"] }] });
