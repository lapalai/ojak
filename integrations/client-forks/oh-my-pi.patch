+			},
+		],
+	};
+	const requests: string[] = [];
+	const fetchImpl: Fetch = async input => {
+		const url = String(input);
+		requests.push(url);
+		if (url === LATEST) return Response.json(app);
+		if (url === API) return Response.json([app, ...releases.map(r => r.release)]);
+		const hit = releases.find(r => url === `${r.base}${MANIFEST}`);
+		if (hit) return new Response(hit.manifest);
