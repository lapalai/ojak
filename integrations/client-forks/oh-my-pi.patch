index 0000000000..aa13b8cb32
--- /dev/null
+++ b/packages/coding-agent/src/cli/ojak-update.ts
@@ -0,0 +1,389 @@
+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+import type { BuildAnswer, Fetch, UpdateChannel } from "./build-service";
+
+/**
+ * omp ships on its own channel: releases tagged `omp-vX.Y.Z-ojak.N`, published but never marked `latest`.
+ * The desktop app updater owns `/releases/latest`, so this one reads a single bounded page of the release list instead.
+ */
+const RELEASES = "https://api.github.com/repos/lapalai/ojak/releases?per_page=30";
+const RELEASES_LIMIT = 4 * 1024 * 1024;
+const TAG = /^omp-v(.+)$/;
+const BASE = "https://github.com/lapalai/ojak/releases/download/";
+/**
+ * Schema-2 feed. Deployed 18.12 updaters read only `omp-compatible.json` (schema 1) and the unversioned asset names,
+ * and never check the local Ojak service. Releases therefore must not carry those names; this feed uses new ones.
+ */
+const MANIFEST = "omp-compatible-v2.json";
+const ASSETS = { "darwin-arm64": "omp-v2-darwin-arm64", "win32-x64": "omp-v2-windows-x64.exe" } as const;
+const SERVICE_VERSION = /^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)$/;
+const VERSION = /^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)-ojak\.([1-9]\d*)$/;
+const record = (v: unknown): v is Record<string, unknown> => typeof v === "object" && v !== null && !Array.isArray(v);
+const MAX_MANIFEST_CHECKS = 5;
+const size = (v: unknown): v is number => Number.isSafeInteger(v) && Number(v) > 0 && Number(v) <= 1024 ** 3;
+
+/** Follow only GitHub's release-asset redirect, never an alternate update host. */
+export function compatibleAssetFetch(fetchImpl: Fetch = fetch): Fetch {
+	return async (input, init) => {
+		let url = String(input);
+		if (!url.startsWith(BASE) || new URL(url).search || new URL(url).hash)
+			throw new Error("Invalid compatible asset URL");
+		for (let hop = 0; hop < 4; hop++) {
+			let response: Response;
+			try {
+				response = await fetchImpl(url, { ...init, redirect: "manual" });
+			} catch {
+				throw new Error("Compatible asset download failed or timed out");
+			}
+			if (![301, 302, 303, 307, 308].includes(response.status)) return response;
+			const location = response.headers.get("location");
+			await response.body?.cancel();
+			if (!location) throw new Error("Missing GitHub asset redirect");
+			const next = new URL(location, url);
+			if (
+				next.protocol !== "https:" ||
+				next.hostname !== "release-assets.githubusercontent.com" ||
+				next.port ||
+				next.username ||
+				next.password ||
+				next.hash
+			)
+				throw new Error("Unsafe GitHub asset redirect");
+			url = next.href;
+		}
+		throw new Error("Too many GitHub asset redirects");
+	};
+}
+
+async function json(
+	url: string,
+	fetchImpl: Fetch,
+	signal: AbortSignal,
+	limit: number,
+	expectedSize?: number,
+): Promise<unknown> {
+	const response = await fetchImpl(url, { signal, redirect: "error", headers: { Accept: "application/json" } });
+	if (!response.ok || !response.body) throw new Error(`Compatible release request failed (${response.status})`);
+	const reader = response.body.getReader();
+	const chunks: Uint8Array[] = [];
+	let length = 0;
+	try {
+		while (true) {
+			const { done, value } = await reader.read();
+			if (done) break;
+			length += value.byteLength;
+			if (length > limit) throw new Error("Compatible metadata exceeds size limit");
+			chunks.push(value);
+		}
+	} finally {
+		await reader.cancel();
+	}
+	if (expectedSize !== undefined && length !== expectedSize) throw new Error("Compatible manifest size mismatch");
+	return JSON.parse(Buffer.concat(chunks).toString("utf8"));
+}
+
+export type CompatibleRelease = BuildAnswer & { minimumOjakService: string };
+
+function parseServiceVersion(value: string): [number, number, number] | undefined {
+	// `major.minor.patch` only; a `-rc.1` / `+build` tail is ignored, as in the launcher.
+	const core = value.trim().split(/[-+]/, 1)[0] ?? "";
+	if (!SERVICE_VERSION.test(core)) return undefined;
+	const [major, minor, patch] = core.split(".").map(Number);
+	return [major!, minor!, patch!];
+}
+
+/** True when `actual` is a well-formed Ojak service version that is at least `minimum`. */
+export function serviceMeets(actual: string | undefined, minimum: string): boolean {
+	const have = actual === undefined ? undefined : parseServiceVersion(actual);
+	const need = parseServiceVersion(minimum);
+	if (!have || !need) return false;
+	for (let i = 0; i < 3; i++) if (have[i] !== need[i]) return have[i]! > need[i]!;
+	return true;
+}
+
+/** Places the `aam` CLI can live when it is not on PATH. The first reachable one that reports a version wins. */
+export function aamCandidates(
+	env: NodeJS.ProcessEnv = process.env,
+	platform: string = process.platform,
+	onPath: string | null = null,
+): string[] {
+	const found = new Set<string>();
+	if (onPath) found.add(onPath);
+	const win = platform === "win32";
+	const join = win ? path.win32.join : path.posix.join;
+	const home =
+		env.AAM_HOME ||
+		(win
+			? join(env.APPDATA || join(os.homedir(), "AppData", "Roaming"), "AI Account Manager")
+			: join(os.homedir(), "Library", "Application Support", "AI Account Manager"));
+	if (win) {
+		// Ojak's NSIS installer puts the real executable at %LOCALAPPDATA%\Ojak\aam.exe. The shim folder only has
+		// `aam.cmd`, a one-line batch file that names that executable; read it instead of running cmd.exe.
+		const local = env.LOCALAPPDATA || join(os.homedir(), "AppData", "Local");
+		const shim = windowsShimTarget(join(home, "bin", "aam.cmd"), { ...env, LOCALAPPDATA: local });
+		if (shim) found.add(shim);
+		found.add(join(local, "Ojak", "aam.exe"));
+	} else {
+		found.add(join(home, "bin", "aam"));
+		found.add(join(os.homedir(), "Applications", "Ojak.app", "Contents", "MacOS", "aam"));
+		found.add("/Applications/Ojak.app/Contents/MacOS/aam");
+	}
+	return [...found];
+}
+
+/** The `aam.exe` named by Ojak's Windows shim (`@"%LOCALAPPDATA%\Ojak\aam.exe" %*`). Only `.exe` targets; otherwise undefined. */
+export function windowsShimTarget(file: string, env: NodeJS.ProcessEnv): string | undefined {
+	let text: string;
+	try {
+		if (fs.statSync(file).size > 4096) return undefined;
+		text = fs.readFileSync(file, "utf8");
+	} catch {
+		return undefined;
+	}
+	const match = /^@"([^"\r\n]+\.exe)" %\*\r?\n?$/i.exec(text.trim() + "\n");
+	if (!match) return undefined;
+	const expanded = match[1]!
+		.replace(/%%/g, "\u0000")
+		.replace(/%([A-Za-z_]+)%/g, (_, name: string) => env[name] ?? `%${name}%`)
+		.replace(/\u0000/g, "%");
+	return expanded.includes("%") || !path.win32.isAbsolute(expanded) ? undefined : expanded;
+}
+
+/**
+ * Version of the RUNNING Ojak service, read through `aam status --json` (`serviceVersion`).
+ * Undefined when no `aam` answers or the service predates the field, so callers fail closed.
+ */
+export async function readOjakServiceVersion(
+	candidates: string[] = aamCandidates(process.env, process.platform, Bun.which("aam")),
+): Promise<string | undefined> {
+	for (const candidate of candidates) {
+		if (!fs.existsSync(candidate)) continue;
+		try {
+			const child = Bun.spawn([candidate, "status", "--json"], {
+				stdin: "ignore",
+				stdout: "pipe",
+				stderr: "ignore",
+				timeout: 20_000,
+				windowsHide: true,
+			});
+			const [text, code] = await Promise.all([new Response(child.stdout).text(), child.exited]);
+			if (code !== 0 || text.length > 32 * 1024 * 1024) continue;
+			const parsed: unknown = JSON.parse(text);
+			if (record(parsed) && typeof parsed.serviceVersion === "string" && parseServiceVersion(parsed.serviceVersion))
+				return parsed.serviceVersion.trim();
+		} catch {}
+	}
+	return undefined;
+}
+
+/** Throws unless the running Ojak service is at least the release's `minimumOjakService`. */
+export async function requireOjakService(
+	minimum: string,
+	read: () => Promise<string | undefined> = readOjakServiceVersion,
+): Promise<string> {
+	const actual = await read();
+	if (!serviceMeets(actual, minimum)) {
+		const seen = actual ? `running service ${actual}` : "no running Ojak service version could be read";
+		throw new Error(`Update Ojak first: this omp needs Ojak service ${minimum} or newer (${seen})`);
+	}
+	return actual!;
+}
+
+/**
+ * Upstream (can1357/oh-my-pi) latest release. Advisory only: it never selects, downloads or installs anything.
+ * Mirrors the launcher's `aam omp-bridge` report so both surfaces use the same wording and states.
+ */
+const UPSTREAM_LATEST = "https://api.github.com/repos/can1357/oh-my-pi/releases/latest";
+const UPSTREAM_TIMEOUT_MS = 10_000;
+
+/** `current`: the compatible release carries the upstream latest; `compatibility-pending`: upstream is ahead; `unknown`: not readable. */
+export type UpstreamStatus = "current" | "compatibility-pending" | "unknown";
+export type UpstreamReport = { status: UpstreamStatus; upstreamVersion: string | null; compatibleVersion: string };
+
+/** Newest published stable upstream version (`X.Y.Z`), or undefined for any failure or odd tag. Never throws. */
+export async function fetchUpstreamLatest(
+	fetchImpl: Fetch = fetch,
+	timeoutMs = UPSTREAM_TIMEOUT_MS,
+): Promise<string | undefined> {
+	try {
+		const body = await json(UPSTREAM_LATEST, fetchImpl, AbortSignal.timeout(timeoutMs), 4 * 1024 * 1024);
+		if (!record(body) || body.draft !== false || body.prerelease !== false || typeof body.tag_name !== "string")
+			return undefined;
+		const tag = body.tag_name.startsWith("v") ? body.tag_name.slice(1) : undefined;
+		return tag !== undefined && SERVICE_VERSION.test(tag) ? tag : undefined;
+	} catch {
+		return undefined;
+	}
+}
+
+function baseOf(version: string): [number, number, number] {
+	const [major, minor, patch] = version.split(/[-+]/, 1)[0]!.split(".").map(Number);
+	return [major!, minor!, patch!];
+}
+
+/** Upstream is "current" only when the compatible base version is at least upstream's; a failed query is "unknown", never "current". */
+export function classifyUpstream(upstreamVersion: string | undefined, compatibleVersion: string): UpstreamReport {
+	if (upstreamVersion === undefined) return { status: "unknown", upstreamVersion: null, compatibleVersion };
+	const [u, c] = [baseOf(upstreamVersion), baseOf(compatibleVersion)];
+	for (let i = 0; i < 3; i++)
+		if (u[i] !== c[i])
+			return { status: u[i]! > c[i]! ? "compatibility-pending" : "current", upstreamVersion, compatibleVersion };
+	return { status: "current", upstreamVersion, compatibleVersion };
+}
+
+export function describeUpstream(report: UpstreamReport): string {
+	switch (report.status) {
+		case "compatibility-pending":
+			return `Upstream latest is ${report.upstreamVersion}; the newest Ojak-compatible release is ${report.compatibleVersion}. Compatibility build, verification and publication for the newer upstream are still pending. Upstream latest is not installed.`;
+		case "current":
+			return `The Ojak-compatible release ${report.compatibleVersion} includes upstream latest ${report.upstreamVersion}.`;
+		case "unknown":
+			return "Upstream latest could not be determined; this report covers the Ojak compatible channel only and does not imply upstream is current.";
+	}
+}
+
+/** A release that cannot be the omp update (never a transport failure); the next candidate is tried. */
+class InvalidRelease extends Error {}
+
+function forkParts(version: string): [number, number, number, number] {
+	const m = VERSION.exec(version)!;
+	return [Number(m[1]), Number(m[2]), Number(m[3]), Number(m[4])];
+}
+
+/** Orders `X.Y.Z-ojak.N` versions numerically (base first, then the Ojak revision). */
+export function compareFork(a: string, b: string): number {
+	const [x, y] = [forkParts(a), forkParts(b)];
+	for (let i = 0; i < 4; i++) if (x[i] !== y[i]) return x[i]! < y[i]! ? -1 : 1;
+	return 0;
+}
+
+type Candidate = { tag: string; version: string; published: number; assets: unknown[] };
+
+/** Shape check of one list entry. `undefined` for releases that are not part of the omp channel; throws for broken omp-tagged ones. */
+function candidate(entry: unknown): Candidate | undefined {
+	if (!record(entry) || typeof entry.tag_name !== "string") return undefined;
+	const tag = entry.tag_name;
+	const match = TAG.exec(tag);
+	if (!match) {
+		if (tag.startsWith("omp-")) throw new InvalidRelease(`${tag}: malformed omp release tag`);
+		return undefined;
+	}
+	if (!VERSION.test(match[1]!)) throw new InvalidRelease(`${tag}: malformed omp release tag`);
+	const published = typeof entry.published_at === "string" ? Date.parse(entry.published_at) : Number.NaN;
+	if (
+		entry.draft !== false ||
+		entry.prerelease !== false ||
+		!Number.isFinite(published) ||
+		!Array.isArray(entry.assets)
+	)
+		throw new InvalidRelease(`${tag}: not a published stable release`);
+	return { tag, version: match[1]!, published, assets: entry.assets };
+}
+
+async function release(
+	item: Candidate,
+	platform: string,
+	fetchImpl: Fetch,
+	signal: AbortSignal,
+): Promise<CompatibleRelease> {
+	const prefix = `${BASE}${item.tag}/`;
+	function asset(name: string): Record<string, unknown> {
+		const found = item.assets.filter(a => record(a) && a.name === name);
+		if (
+			found.length !== 1 ||
+			!record(found[0]) ||
+			found[0].browser_download_url !== `${prefix}${name}` ||
+			!size(found[0].size)
+		)
+			throw new InvalidRelease(`${item.tag}: missing or invalid same-release asset ${name}`);
+		return found[0];
+	}
+	const manifestAsset = asset(MANIFEST);
+	if (Number(manifestAsset.size) > 64 * 1024)
+		throw new InvalidRelease(`${item.tag}: compatible manifest exceeds size limit`);
+	asset(ASSETS[platform as keyof typeof ASSETS]);
+	const manifest = await json(
+		String(manifestAsset.browser_download_url),
+		compatibleAssetFetch(fetchImpl),
+		signal,
+		64 * 1024,
+		Number(manifestAsset.size),
+	);
+	if (
+		!record(manifest) ||
+		manifest.schemaVersion !== 2 ||
+		manifest.admissionProtocol !== 1 ||
+		typeof manifest.version !== "string" ||
+		!VERSION.test(manifest.version) ||
+		typeof manifest.minimumOjakService !== "string" ||
+		!SERVICE_VERSION.test(manifest.minimumOjakService) ||
+		!record(manifest.platforms)
+	)
+		throw new InvalidRelease(`${item.tag}: invalid Ojak compatibility manifest or admission protocol`);
+	if (manifest.version !== item.version)
+		throw new InvalidRelease(`${item.tag}: manifest version ${manifest.version} does not match the tag`);
+	for (const [key, name] of Object.entries(ASSETS)) {
+		const entry = manifest.platforms[key];
+		if (
+			!record(entry) ||
+			entry.asset !== name ||
+			!size(entry.size) ||
+			typeof entry.sha256 !== "string" ||
+			!/^[a-f0-9]{64}$/.test(entry.sha256)
+		)
+			throw new InvalidRelease(`${item.tag}: invalid compatible platform ${key}`);
+		const published = asset(name);
+		if (published.size !== entry.size || (published.digest != null && published.digest !== `sha256:${entry.sha256}`))
+			throw new InvalidRelease(`${item.tag}: inconsistent compatible asset ${name}`);
+	}
+	const entry = manifest.platforms[platform] as { asset: string; size: number; sha256: string };
+	return {
+		version: manifest.version,
+		minimumOjakService: manifest.minimumOjakService,
+		file: { name: entry.asset, size: entry.size, sha256: entry.sha256 },
+		download: `${prefix}${entry.asset}`,
+	};
+}
+
+/** Newest valid release of the omp channel (highest `X.Y.Z-ojak.N`, then latest publication). Never reads `/releases/latest`. */
+export async function fetchCompatibleRelease(
+	options: {
+		fetchImpl?: Fetch;
+		platform?: string;
+		channel?: UpdateChannel;
+		timeoutMs?: number;
+	} = {},
+): Promise<CompatibleRelease> {
+	if (options.channel === "canary")
+		throw new Error("Ojak supports only published stable compatible releases; canary is unavailable");
+	const platform = options.platform ?? `${process.platform}-${process.arch}`;
+	if (!Object.hasOwn(ASSETS, platform)) throw new Error(`No compatible Ojak update for ${platform}`);
+	const fetchImpl = options.fetchImpl ?? fetch;
+	const signal = AbortSignal.timeout(Math.min(options.timeoutMs ?? 30_000, 30_000));
+	const list = await json(RELEASES, fetchImpl, signal, RELEASES_LIMIT);
+	if (!Array.isArray(list)) throw new Error("Invalid Ojak release list");
+	const skipped: string[] = [];
+	const candidates: Candidate[] = [];
+	for (const entry of list) {
+		try {
+			const found = candidate(entry);
+			if (found) candidates.push(found);
+		} catch (error) {
+			if (!(error instanceof InvalidRelease)) throw error;
+			skipped.push(error.message);
+		}
+	}
+	candidates.sort((a, b) => compareFork(b.version, a.version) || b.published - a.published);
+	for (const item of candidates.slice(0, MAX_MANIFEST_CHECKS)) {
+		try {
+			return await release(item, platform, fetchImpl, signal);
+		} catch (error) {
+			if (!(error instanceof InvalidRelease)) throw error;
+			skipped.push(error.message);
+		}
+	}
+	throw new Error(
+		`No valid published omp release found in the Ojak omp channel${skipped.length ? ` (${skipped.slice(0, 5).join("; ")})` : ""}`,
+	);
+}
