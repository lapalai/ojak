+	const base = `https://github.com/lapalai/ojak/releases/download/${tag}/`;
+	const entry = (asset: string) => ({ asset, size: bytes.length, sha256: Bun.SHA256.hash(bytes, "hex") });
+	const manifest = {
+		schemaVersion: 2,
+		admissionProtocol: 1,
+		version,
+		minimumOjakService: minimum,
+		platforms: { "darwin-arm64": entry(DARWIN), "win32-x64": entry(WINDOWS) },
+	};
+	const manifestBytes = JSON.stringify(manifest);
+	const release = {
+		draft: false,
+		prerelease: false,
+		published_at: "2026-11-03T12:00:00Z",
+		tag_name: tag,
+		assets: [
+			{ name: MANIFEST, size: Buffer.byteLength(manifestBytes), browser_download_url: `${base}${MANIFEST}` },
+			{ name: DARWIN, size: bytes.length, browser_download_url: `${base}${DARWIN}` },
+			{ name: WINDOWS, size: bytes.length, browser_download_url: `${base}${WINDOWS}` },
+		],
+		...over,
+	};
+	return { release, manifest: manifestBytes, base };
+}
