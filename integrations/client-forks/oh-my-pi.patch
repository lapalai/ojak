--- /dev/null
+++ b/packages/coding-agent/src/session/admission-recovery.ts
@@ -0,0 +1,41 @@
+import type { AssistantMessage } from "@oh-my-pi/pi-ai";
+
+/** Terminal bridge outcomes have distinct meanings, but all veto automatic provider submission. */
+export function automaticRecoveryVeto(
+	message: AssistantMessage,
+): "execution_unknown" | "admission_paused" | "admission_stopped" | undefined {
+	const classification = message.errorClassificationMessage ?? "";
+	const detail = message.errorMessage ?? "";
+	if (
+		message.errorType === "execution_unknown" ||
+		message.errorCode === "BRIDGE_EXECUTION_UNKNOWN" ||
+		/\b(?:execution_unknown|BRIDGE_EXECUTION_UNKNOWN)\b/.test(classification) ||
+		/\b(?:execution_unknown|BRIDGE_EXECUTION_UNKNOWN)\b/.test(detail)
+	)
+		return "execution_unknown";
+	if (
+		message.errorCode === "BRIDGE_ADMISSION_STOPPED" ||
+		/\bBRIDGE_ADMISSION_STOPPED\b/.test(classification) ||
+		/\bBRIDGE_ADMISSION_STOPPED\b/.test(detail)
+	)
+		return "admission_stopped";
+	if (
+		message.errorCode === "BRIDGE_ADMISSION_PAUSED" ||
+		/\bBRIDGE_ADMISSION_PAUSED\b/.test(classification) ||
+		/\bBRIDGE_ADMISSION_PAUSED\b/.test(detail)
+	)
+		return "admission_paused";
+	return undefined;
+}
+
+/** Explicit continuation is safe only for an output-free, positively identified pre-send pause. */
+export function isResumableAdmissionPause(message: AssistantMessage): boolean {
+	return (
+		message.stopReason === "error" &&
