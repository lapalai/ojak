+			messages: options.messages ?? manager.buildSessionContext().messages,
+		},
+		convertToLlm,
+		streamFn: async (model, context, streamOptions) => {
+			await options.beforeRequest?.(runner.createContext(), streamOptions);
+			return mock.stream(model, context, streamOptions);
+		},
+	});
